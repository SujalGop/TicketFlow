# =============================================================================
# TicketFlow Server Environment Variables (Production & Development Template)
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Replica Set URI required for Mongoose ACID Transactions)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ticketflow?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/ticketflow?retryWrites=true&w=majority

# Authentication (JSON Web Tokens)
JWT_SECRET=super_secret_long_random_jwt_key_at_least_32_characters_for_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway
# Test or Live API keys from Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret
# Set in Razorpay Dashboard > Settings > Webhooks (for endpoint https://your-backend.onrender.com/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Frontend Production Origin (Supports comma-separated URLs)
# Example: https://ticketflow.vercel.app
CLIENT_URL=https://your-frontend.vercel.app
